{
    "name": "qiick/conformance-harness",
    "description": "Proves each fleet conformance check goes RED on a broken fixture and GREEN on a correct one",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0|^10.0|^9.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Qiick\\Standards\\Conformance\\": "../conformance/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qiick\\ConformanceHarness\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
